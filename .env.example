NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/documind

JWT_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-characters
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_COOKIE_MAX_AGE_MS=604800000
REFRESH_COOKIE_NAME=documind_refresh_token
PASSWORD_SALT_ROUNDS=12

OPENAI_API_KEY=replace-with-openai-api-key
AI_MODEL=gpt-4o-mini
AI_FREE_DAILY_QUOTA=10
AI_MAX_DOCUMENT_CHARS=8000
AI_MAX_CHAT_HISTORY_MESSAGES=6
AI_SUMMARY_MAX_OUTPUT_TOKENS=600
AI_CHAT_MAX_OUTPUT_TOKENS=1000
GOOGLE_CLIENT_ID=

RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret
PRO_PLAN_PRICE_PAISE=29900
PRO_PLAN_CURRENCY=INR

LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
UPLOAD_DIR=uploads
FREE_PLAN_MAX_DOCUMENTS=3
FREE_PLAN_MAX_FILE_SIZE_BYTES=5242880
PRO_PLAN_MAX_FILE_SIZE_BYTES=10485760
